@"
.venv/
__pycache__/
*.pyc
.idea/
.env
.env.*
!.env.example
"@ | Out-File -Encoding utf8 .gitignore


<template>
  <view v-if="visible" class="image-preview-mask" @click="handleMaskClick">
    <view class="image-preview-panel">
      <view class="image-preview-header" @click.stop>
        <text class="preview-counter">{{ safeCurrentIndex + 1 }} / {{ normalizedUrls.length }}</text>
        <view class="preview-close" @click.stop="close">关闭</view>
      </view>
      <swiper
        class="image-preview-swiper"
        :current="safeCurrentIndex"
        circular
        @change="handleChange"
        @click.stop
      >
        <swiper-item v-for="(img, idx) in normalizedUrls" :key="idx">
          <view class="image-preview-item">
            <image class="image-preview-img" :src="img" mode="aspectFit"></image>
          </view>
        </swiper-item>
      </swiper>
    </view>
  </view>
</template>

<script>
export default {
  name: 'ImagePreview',
  props: {
    visible: {
      type: Boolean,
      default: false
    },
    imageUrls: {
      type: Array,
      default: () => []
    },
    currentIndex: {
      type: Number,
      default: 0
    }
  },
  data () {
    return {
      internalIndex: 0
    }
  },
  computed: {
    normalizedUrls () {
      return (this.imageUrls || [])
        .map(item => (typeof item === 'string' ? item : item && item.url))
        .filter(Boolean)
        .map(url => {
          if (/^https?:\/\//i.test(url)) return url
          if (url.startsWith('//')) return `${location.protocol}${url}`
          return `${location.origin}${url.startsWith('/') ? '' : '/'}${url}`
        })
    },
    safeCurrentIndex () {
      if (!this.normalizedUrls.length) return 0
      return Math.min(Math.max(Number(this.internalIndex) || 0, 0), this.normalizedUrls.length - 1)
    }
  },
  watch: {
    visible (val) {
      if (val) this.internalIndex = this.currentIndex || 0
    },
    currentIndex: {
      immediate: true,
      handler (val) { this.internalIndex = val }
    }
  },
  methods: {
    close () {
      this.$emit('close')
    },
    handleMaskClick () {
      this.close()
    },
    handleChange (e) {
      this.internalIndex = e.detail.current
    }
  }
}
</script>

<style lang="less" scoped>
.image-preview-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  background: rgba(0, 0, 0, 0.92);
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.image-preview-panel {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.image-preview-header {
  top: 150rpx;
  flex-shrink: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 44rpx 32rpx 20rpx;
  color: #fff;
  font-size: 28rpx;
  position: relative;
  z-index: 999;
}

.preview-counter {
  color: rgba(255, 255, 255, 0.8);
}

.preview-close {
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  font-size: 26rpx;
  min-width: 80rpx;
  text-align: center;
}

.image-preview-swiper {
  flex: 1;
  width: 100%;
  height: 0;
}

.image-preview-item {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 24rpx 80rpx;
  box-sizing: border-box;
}

.image-preview-img {
  width: 100%;
  height: 100%;
  pointer-events: none;
}
</style>
